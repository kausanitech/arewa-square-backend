# ══════════════════════════════════════════════════════════
# AREWA SQUARE BACKEND — environment variables
# Copy this file to .env and fill in real values.
# Never commit the real .env file.
# ══════════════════════════════════════════════════════════

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/arewa-square?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=30d

# CORS — comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=https://arewasquare.com,http://localhost:3000,http://127.0.0.1:5500

# File uploads
# NOTE: local disk storage on Railway is wiped on every redeploy — this is a
# known gap. Migrate to Cloudinary or S3 before relying on uploaded files
# surviving a deploy. See utils/upload.js for where to swap the storage engine.
MAX_UPLOAD_SIZE_MB=5

# Optional — only needed once password-reset emails are wired up (known gap)
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM="AREWA SQUARE <no-reply@arewasquare.com>"
